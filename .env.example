# ==============================================================================
# CONFIGURACIÓN DEL ASISTENTE ACADÉMICO (PLANTILLA LIMPIA SIN DATOS PERSONALES)
# ==============================================================================

# 1. Configuración de Canvas LMS
# URL base de tu institución (sin barra al final)
CANVAS_BASE_URL=https://tu-institucion.instructure.com
# Token de acceso personal generado en Canvas (Cuenta -> Configuración -> Nuevo token de acceso)
CANVAS_API_TOKEN=tu_token_de_canvas_aqui

# 2. Autenticación en Google Workspace (Elige Opción A o B)
# OPCIÓN A (Recomendada - Sin caducidad y con mínimo privilegio): Cuenta de Servicio
# Contenido íntegro del JSON de la Cuenta de Servicio (en una línea en GitHub Secrets) o ruta local al archivo .json
GOOGLE_SERVICE_ACCOUNT_JSON=

# OPCIÓN B (Alternativa OAuth 2.0 en modo Producción):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# 3. Configuración de Google Drive
# Nombre o ID de la carpeta raíz de estudio compartida con el asistente
DRIVE_ROOT_FOLDER_NAME=INGENIERIA
DRIVE_ROOT_FOLDER_ID=

# 4. Configuración de Google Calendar
# Nombre o ID del calendario de entregas y del calendario de clases
CALENDAR_NAME=Canvas - Universidad
CALENDAR_ID=
CLASSES_CALENDAR_NAME=CLASES
CLASSES_CALENDAR_ID=

# 5. Inteligencia Artificial (Gemini API - Google AI Studio)
# Opcional para mapeo semántico de asignaturas, clasificación en subcarpetas y resúmenes de entregas
GEMINI_API_KEY=

# 6. Privacidad y Logging
LOG_LEVEL=INFO
# En GitHub Actions se activa automáticamente a true para no mostrar nombres ni datos sensibles en logs públicos
PUBLIC_LOG_MODE=false
