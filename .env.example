# ==========================================
# CONFIGURACIÓN DEL ASISTENTE ACADÉMICO
# ==========================================

# 1. Configuración de Canvas LMS
# URL base de tu institución (sin barra al final)
# Ejemplos: https://ucm.instructure.com o https://canvas.instructure.com
CANVAS_BASE_URL=https://tu-institucion.instructure.com

# Token de acceso personal generado en Canvas (Cuenta -> Configuración -> Integraciones aprobadas)
CANVAS_API_TOKEN=tu_token_de_canvas_aqui

# 2. Configuración de Google OAuth 2.0 (obtenido de Google Cloud Console)
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret
GOOGLE_REFRESH_TOKEN=tu_refresh_token_generado_con_auth_setup

# 3. Configuración de Google Drive
# Carpeta de estudio raíz donde están o irás creando tus cursos (ej: INGENIERIA)
DRIVE_ROOT_FOLDER_NAME=INGENIERIA

# 4. Configuración de Google Calendar
# Nombre del calendario específico a utilizar (o 'primary' para el calendario principal)
CALENDAR_NAME=Canvas - Universidad

# 5. Inteligencia Artificial (Gemini API - Google AI Studio)
# Opcional pero recomendado para mapeo inteligente de asignaturas y organización por temas
GEMINI_API_KEY=tu_api_key_de_gemini_opcional

# 5. Seguridad del Servicio Web (Opcional pero recomendado para llamadas manuales)
# Clave secreta para autorizar la sincronización manual vía navegador/curl (ej: /sync?token=mi_clave)
SYNC_SECRET_TOKEN=clave_secreta_para_disparos_manuales

# 6. Entorno y Logging
LOG_LEVEL=INFO
PORT=8080
